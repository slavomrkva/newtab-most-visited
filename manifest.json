{
  "manifest_version": 3,
  "name": "New Tab – Most Visited",
  "short_name": "New Tab",
  "version": "3.0.0",
  "description": "Your most visited sites from history, weather forecast, a daily nature photo, to-dos, notes and a focus timer.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "history",
    "storage",
    "unlimitedStorage",
    "geolocation",
    "tabs",
    "favicon"
  ],
  "host_permissions": [
    "https://www.bing.com/HPImageArchive.aspx*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://api.bigdatacloud.net/*",
    "https://www.google.com/s2/favicons*",
    "https://t0.gstatic.com/faviconV2*",
    "https://t1.gstatic.com/faviconV2*",
    "https://t2.gstatic.com/faviconV2*",
    "https://t3.gstatic.com/faviconV2*",
    "https://icons.duckduckgo.com/*"
  ]
}
